# Database - MySQL
# Thay user, password, host, database cho đúng máy bạn
DATABASE_URL=mysql+pymysql://root:password@127.0.0.1:3306/chi_tieu_ai?charset=utf8mb4

# Nếu chưa có MySQL, có thể dùng SQLite tạm:
# DATABASE_URL=sqlite:///./chi_tieu_ai.db

# JWT (development default; set a unique value for production)
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Provider (mock / Gemini / OpenAI)
# Để trống = dùng AI mock (local, không gọi API ngoài)
AI_API_KEY=

AI_PROVIDER=mock
# AI_PROVIDER=gemini + GEMINI_API_KEY=...
# AI_PROVIDER=openai + OPENAI_API_KEY=...
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_SECONDS=30

# Admin seed
ADMIN_EMAIL=admin@gmail.com
# Development default; replace before production deployment.
ADMIN_PASSWORD=admin123
ADMIN_NAME=Quản trị viên

# Password reset email (required for forgot-password)
APP_BASE_URL=http://127.0.0.1:8000
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=10

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=30
MAX_CHAT_MESSAGES=100
MAX_CHAT_TOKENS=50000
